                                    },
                                    {
                                        "type": "string",
                                        "enums": [
                                            {
                                                "code": "BUS_STATION",
                                                "name": "GV_ENUM_BUS_STATION"
                                            },
                                            {
                                                "code": "BORDER_CROSSING",
                                                "name": "GV_ENUM_BORDER_CROSSING"
                                            },
                                            {
                                                "code": "CHECKPOINT",
                                                "name": "GV_ENUM_CHECKPOINT"
                                            },
                                            {
                                                "code": "FERRY_TERMINAL",
                                                "name": "GV_ENUM_FERRY_TERMINAL"
                                            },
                                            {
                                                "code": "OTHER",
                                                "name": "GV_ENUM_OTHER"
                                            }
                                        ],
                                        "label": "GV_TRANSIT_LOCATION_TYPE_LABEL",
                                        "order": 4,
                                        "value": "",
                                        "format": "dropdown",
                                        "hidden": false,
                                        "tooltip": "",
                                        "helpText": "",
                                        "infoText": "",
                                        "readOnly": false,
                                        "fieldName": "transitLocationType",
                                        "mandatory": true,
                                        "deleteFlag": false,
                                        "innerLabel": "",
                                        "systemDate": false,
                                        "validations": [
                                            {
                                                "type": "required",
                                                "value": true,
                                                "message": "GV_VALIDATION_REQUIRED"
                                            }
                                        ],
                                        "errorMessage": "",
                                        "isMultiSelect": false
                                    },
                                    {
                                        "type": "string",
                                        "label": "GV_TRANSIT_SITE_LANDMARK_LABEL",
                                        "order": 5,
                                        "value": "",
                                        "format": "text",
                                        "hidden": false,
                                        "tooltip": "",
                                        "helpText": "GV_TRANSIT_SITE_LANDMARK_HELPTEXT",
                                        "infoText": "",
                                        "readOnly": false,
                                        "fieldName": "locationName",
                                        "mandatory": true,
                                        "deleteFlag": false,
                                        "innerLabel": "",
                                        "systemDate": false,
                                        "lengthRange": {
                                            "maxLength": "200",
                                            "minLength": "1",
                                            "errorMessage": "GV_VALIDATION_MAX_200"
                                        },
                                        "validations": [
                                            {
                                                "type": "required",
                                                "value": true,
                                                "message": "GV_VALIDATION_REQUIRED"
                                            },
                                            {
                                                "type": "maxLength",
                                                "value": "200",
                                                "message": "GV_VALIDATION_MAX_200"
                                            }
                                        ],
                                        "errorMessage": "",
                                        "isMultiSelect": false,
                                        "textCapitalization": "words"
                                    },
                                    {
                                        "type": "string",
                                        "label": "GV_WORKER_NAME_LABEL",
                                        "order": 6,
                                        "value": "",
                                        "format": "text",
                                        "hidden": false,
                                        "tooltip": "",
                                        "helpText": "",
                                        "infoText": "",
                                        "readOnly": true,
                                        "fieldName": "workerName",
                                        "deleteFlag": false,
                                        "innerLabel": "",
                                        "systemDate": false,
                                        "validations": [],
                                        "errorMessage": "",
