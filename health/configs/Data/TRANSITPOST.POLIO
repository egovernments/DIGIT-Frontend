                    },
                    {
                        "body": [
                            {
                                "type": "template",
                                "format": "card",
                                "children": [
                                    {
                                        "data": [
                                            {
                                                "key": "GV_SUMMARY_LOCATION_NAME",
                                                "value": "{{contextData.0.UserActionModel.additionalFields.fields.locationName}}"
                                            },
                                            {
                                                "key": "GV_SUMMARY_LOCATION_TYPE",
                                                "value": "{{contextData.0.UserActionModel.additionalFields.fields.transitLocationType}}"
                                            }
                                        ],
                                        "type": "template",
                                        "format": "labelPairList",
                                        "fieldName": "sessionDetails"
                                    }
                                ],
                                "fieldName": "sessionCard",
                                "properties": {
                                    "type": "primary"
                                }
                            },
                            {
                                "type": "template",
                                "value": "GV_SESSION_OVERVIEW_TODAY",
                                "format": "textTemplate",
                                "fieldName": "todaysProgressTitle",
                                "properties": {
                                    "style": "headingS",
                                    "bottomGap": 4
                                }
                            },
                            {
                                "type": "template",
                                "format": "card",
                                "children": [
                                    {
                                        "type": "template",
                                        "value": "{{contextData.0.children.length}}",
                                        "format": "textTemplate",
                                        "fieldName": "vaccinatedCount",
                                        "properties": {
                                            "style": "headingXl",
                                            "bottomGap": 4
                                        }
                                    },
                                    {
                                        "type": "template",
                                        "value": "GV_METRIC_VACCINATED_TODAY",
                                        "format": "textTemplate",
                                        "fieldName": "vaccinatedLabel",
                                        "properties": {
                                            "style": "bodyS",
                                            "bottomGap": 4
                                        }
                                    },
                                    {
                                        "type": "template",
                                        "format": "row",
                                        "children": [
                                            {
                                                "flex": 1,
                                                "type": "template",
                                                "format": "card",
                                                "children": [
                                                    {
                                                        "type": "template",
                                                        "format": "row",
                                                        "children": [
                                                            {
                                                                "type": "template",
                                                                "value": "{{contextData.0.femaleChildren.length}}",
                                                                "format": "textTemplate",
                                                                "fieldName": "femaleCount",
                                                                "properties": {
                                                                    "color": "primary",
                                                                    "style": "headingM"
                                                                }
                                                            },
                                                            {
                                                                "type": "template",
                                                                "value": "GV_ENUM_FEMALE",
                                                                "format": "textTemplate",
                                                                "fieldName": "femaleLabel",
                                                                "properties": {
                                                                    "color": "primary",
                                                                    "style": "bodyS"
                                                                }
                                                            }
                                                        ],
                                                        "fieldName": "femalePillRow",
                                                        "properties": {
                                                            "gap": 4,
                                                            "mainAxisSize": "max",
                                                            "mainAxisAlignment": "center",
                                                            "crossAxisAlignment": "center"
                                                        }
                                                    }
                                                ],
                                                "fieldName": "femalePill",
                                                "properties": {
                                                    "type": "secondary",
                                                    "radius": "radius4"
                                                }
                                            },
                                            {
                                                "flex": 1,
                                                "type": "template",
                                                "format": "card",
                                                "children": [
                                                    {
                                                        "type": "template",
                                                        "format": "row",
                                                        "children": [
                                                            {
                                                                "type": "template",
                                                                "value": "{{contextData.0.malesChildren.length}}",
                                                                "format": "textTemplate",
                                                                "fieldName": "maleCount",
                                                                "properties": {
                                                                    "color": "primary",
                                                                    "style": "headingM"
                                                                }
                                                            },
                                                            {
                                                                "type": "template",
                                                                "value": "GV_ENUM_MALE",
                                                                "format": "textTemplate",
                                                                "fieldName": "maleLabel",
                                                                "properties": {
                                                                    "color": "primary",
                                                                    "style": "bodyS"
                                                                }
                                                            }
                                                        ],
