        {
            "id": "856b0d77-50cc-4928-aa4e-88229c3c4a4f",
            "tenantId": "mz",
            "schemaCode": "HCM-ADMIN-CONSOLE.FormConfigTemplate",
            "uniqueIdentifier": "TRANSITPOST.POLIO",
            "data": {
                "name": "TRANSITPOST",
                "flows": [
                    {
                        "body": [
                            {
                                "type": "template",
                                "label": "GV_SESSIONS_EMPTY_MESSAGE",
                                "format": "infoCard",
                                "visible": "{{fn:isEmpty(contextData)}}",
                                "fieldName": "emptyState",
                                "description": "GV_SESSIONS_EMPTY_DESCRIPTION"
                            },
                            {
                                "type": "template",
                                "child": {
                                    "type": "template",
                                    "format": "card",
                                    "children": [
                                        {
                                            "type": "template",
                                            "value": "{{item.UserActionModel.additionalFields.fields.locationName}}",
                                            "format": "textTemplate",
                                            "fieldName": "sessionLocationName",
                                            "properties": {
                                                "style": "headingL",
                                                "bottomGap": 8
                                            }
                                        },
                                        {
                                            "type": "template",
                                            "label": "GV_SESSION_LAST_USED_ON {{fn:formatDate(item.lastActivityTs, 'date', 'dd MMM yyyy HH:mm')}}",
                                            "format": "tag",
                                            "fieldName": "lastUsedChip",
                                            "properties": {
                                                "icon": "Schedule",
                                                "tagType": "monochrome",
                                                "bottomGap": 12
                                            }
                                        },
                                        {
                                            "data": [
                                                {
                                                    "key": "GV_SUMMARY_LOCATION_TYPE",
                                                    "value": "{{item.UserActionModel.additionalFields.fields.transitLocationType}}"
                                                },
                                                {
                                                    "key": "GV_SUMMARY_SESSION_DATE",
                                                    "value": "{{fn:formatDate(item.UserActionModel.clientAuditDetails.createdTime, 'date', 'dd MMM yyyy')}}"
                                                },
                                                {
                                                    "key": "GV_METRIC_VACCINATED_TODAY",
                                                    "value": "{{item.children.length}}"
                                                },
                                                {
                                                    "key": "GV_METRIC_VACCINATED_BY_GENDER",
                                                    "value": "{{item.malesChildren.length}}M | {{item.femaleChildren.length}}F"
                                                },
                                                {
                                                    "key": "GV_METRIC_CHILDREN_REFERRED",
                                                    "value": "{{item.referrals.length}}"
                                                }
                                            ],
                                            "type": "template",
                                            "format": "labelPairList",
                                            "fieldName": "sessionSummary"
                                        },
                                        {
                                            "type": "template",
                                            "label": "GV_RESUME_SESSION_BUTTON",
                                            "format": "button",
                                            "onAction": [
                                                {
                                                    "actionType": "NAVIGATION",
                                                    "properties": {
                                                        "data": [
                                                            {
                                                                "key": "SessionClientReferenceId",
                                                                "value": "{{item.UserActionModel.clientReferenceId}}"
                                                            },
                                                            {
                                                                "key": "SessionType",
                                                                "value": "TRANSIT"
                                                            }
                                                        ],
                                                        "name": "transitSessionOverview",
                                                        "type": "TEMPLATE"
                                                    }
                                                }
                                            ],
                                            "fieldName": "resumeSession",
                                            "mandatory": true,
                                            "properties": {
                                                "size": "medium",
                                                "type": "secondary",
                                                "mainAxisSize": "max",
                                                "mainAxisAlignment": "center"
                                            }
                                        }
                                    ],
                                    "fieldName": "sessionCard",
                                    "properties": {
                                        "type": "secondary",
                                        "spacing": 0,
                                        "cardType": "secondary"
                                    }
                                },
                                "format": "listView",
                                "fieldName": "listViewSessions",
                                "properties": {
                                    "spacing": "spacer4"
                                }
                            }
                        ],
                        "name": "transitSessionsList",
                        "order": 1,
                        "canPop": true,
                        "footer": [
                            {
                                "type": "template",
                                "label": "GV_START_SESSION_BUTTON",
                                "format": "button",
                                "onAction": [
                                    {
                                        "actionType": "NAVIGATION",
                                        "properties": {
                                            "name": "transitSessionSetup",
                                            "type": "FORM"
                                        }
                                    }
                                ],
                                "fieldName": "startSession",
                                "mandatory": true,
                                "properties": {
                                    "size": "large",
                                    "type": "primary",
                                    "mainAxisSize": "max",
                                    "mainAxisAlignment": "center"
                                }
                            }
                        ],
                        "header": [
                            {
                                "type": "template",
                                "label": "GV_BACK_LABEL",
                                "format": "backLink",
                                "onAction": [
                                    {
                                        "actionType": "BACK_NAVIGATION",
                                        "properties": {
                                            "name": "HOME",
                                            "type": "HOME"
                                        }
                                    }
                                ],
                                "fieldName": "backLink"
                            }
                        ],
                        "heading": "GV_TRANSIT_SESSIONS_HEADING",
                        "category": "TRANSITPOST_SESSIONS",
                        "screenType": "TEMPLATE",
                        "description": "GV_TRANSIT_SESSIONS_DESCRIPTION",
                        "initActions": [
                            {
                                "actionType": "SEARCH_EVENT",
                                "properties": {
                                    "data": [
                                        {
                                            "key": "tenantId",
                                            "root": "userAction",
                                            "value": "{{singleton.selectedProject.tenantId}}",
                                            "operation": "equals"
                                        },
                                        {
                                            "key": "projectId",
                                            "root": "userAction",
                                            "value": "{{singleton.selectedProject.id}}",
                                            "operation": "equals"
                                        },
                                        {
                                            "key": "boundaryCode",
                                            "root": "userAction",
                                            "value": "{{singleton.boundary.code}}",
                                            "operation": "equals"
                                        }
                                    ],
                                    "name": "sessions",
                                    "type": "SEARCH_EVENT"
                                }
                            }
                        ],
                        "wrapperConfig": {
                            "filters": [
                                {
                                    "field": "additionalFields.fields.sessionType",
                                    "equals": "TRANSIT"
                                }
                            ],
                            "computed": {
                                "_maxChildTs": {
                                    "from": "children",
                                    "order": 1,
                                    "reduce": {
                                        "field": "clientAuditDetails.createdTime",
                                        "fallback": 0,
                                        "operation": "max"
                                    }
                                },
                                "_maxActivityTs": {
                                    "order": 3,
                                    "fallback": 0,
                                    "condition": {
                                        "if": {
                                            "left": "{{_maxChildTs}}",
                                            "right": "{{_maxReferralTs}}",
                                            "operator": "gt"
                                        },
                                        "else": "{{_maxReferralTs}}",
                                        "then": "{{_maxChildTs}}"
                                    }
                                },
                                "_maxReferralTs": {
                                    "from": "referrals",
                                    "order": 2,
                                    "reduce": {
                                        "field": "clientAuditDetails.createdTime",
                                        "fallback": 0,
                                        "operation": "max"
                                    }
                                },
                                "lastActivityTs": {
                                    "order": 4,
                                    "fallback": "{{UserActionModel.clientAuditDetails.createdTime}}",
                                    "condition": {
                                        "if": {
                                            "left": "{{_maxActivityTs}}",
                                            "right": 0,
                                            "operator": "gt"
                                        },
                                        "else": "{{UserActionModel.clientAuditDetails.createdTime}}",
                                        "then": "{{_maxActivityTs}}"
                                    }
                                }
                            },
                            "relations": [
                                {
                                    "name": "children",
                                    "match": {
                                        "field": "resourceTag",
                                        "equalsFrom": "clientReferenceId"
                                    },
                                    "entity": "UserActionModel",
                                    "filters": [
                                        {
                                            "field": "additionalFields.fields.formType",
                                            "equals": "GROUP_VAC_CHILD"
                                        }
                                    ]
                                },
                                {
                                    "name": "malesChildren",
                                    "match": {
                                        "field": "resourceTag",
                                        "equalsFrom": "clientReferenceId"
                                    },
                                    "entity": "UserActionModel",
                                    "filters": [
                                        {
                                            "field": "additionalFields.fields.formType",
                                            "equals": "GROUP_VAC_CHILD"
                                        },
                                        {
                                            "field": "additionalFields.fields.childSex",
                                            "equals": "MALE"
                                        }
                                    ]
                                },
                                {
                                    "name": "femaleChildren",
                                    "match": {
                                        "field": "resourceTag",
                                        "equalsFrom": "clientReferenceId"
                                    },
                                    "entity": "UserActionModel",
                                    "filters": [
                                        {
                                            "field": "additionalFields.fields.formType",
                                            "equals": "GROUP_VAC_CHILD"
                                        },
                                        {
                                            "field": "additionalFields.fields.childSex",
                                            "equals": "FEMALE"
                                        }
                                    ]
                                },
                                {
                                    "name": "referrals",
                                    "match": {
                                        "field": "resourceTag",
                                        "equalsFrom": "clientReferenceId"
                                    },
                                    "entity": "UserActionModel",
                                    "filters": [
                                        {
                                            "field": "additionalFields.fields.formType",
                                            "equals": "GROUP_VAC_REFERRAL"
                                        }
                                    ]
                                }
                            ],
                            "rootEntity": "UserActionModel",
                            "wrapperName": "TransitSessionsListWrapper",
                            "searchConfig": {
                                "select": [
                                    "userAction"
                                ],
                                "orderBy": {
                                    "field": "clientCreatedTime",
                                    "order": "DESC"
                                },
                                "primary": "userAction"
                            }
                        }
                    },
                    {
                        "name": "transitSessionSetup",
                        "pages": [
                            {
                                "page": "sessionSetup",
                                "type": "object",
                                "label": "GV_TRANSIT_SESSION_SETUP_LABEL",
                                "order": 1,
                                "value": null,
