                                        "deleteFlag": false,
                                        "innerLabel": "",
                                        "systemDate": false,
                                        "validations": [
                                            {
                                                "type": "required",
                                                "value": true,
                                                "message": "GV_VALIDATION_GPS_REQUIRED"
                                            }
                                        ],
                                        "errorMessage": "",
