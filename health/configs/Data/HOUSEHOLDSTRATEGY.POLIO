                                                            }
                                                        ],
                                                        "name": "projectBeneficiary",
                                                        "type": "SEARCH_EVENT",
                                                        "awaitResults": true
                                                    }
                                                }
                                            ],
                                            "scanLimit": 1,
                                            "singleValue": true
                                        }
                                    }
                                ],
                                "fieldName": "searchScanBeneficiaryButton",
                                "scanLimit": 1,
                                "showLabel": false,
                                "properties": {
                                    "icon": "QrCodeScanner",
                                    "size": "large",
                                    "type": "secondary",
                                    "mainAxisSize": "max",
                                    "mainAxisAlignment": "center"
