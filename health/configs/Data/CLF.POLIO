                        "wrapperConfig": {
                            "filters": [
                                {
                                    "field": "additionalFields.fields.sessionType",
                                    "equals": "CLF"
                                }
                            ],
                            "relations": [
                                {
                                    "name": "children",
                                    "match": {
                                        "field": "resourceTag",
                                        "equalsFrom": "clientReferenceId"
                                    },
                                    "entity": "UserActionModel",
                                    "filters": [
                                        {
                                            "field": "additionalFields.fields.formType",
                                            "equals": "GROUP_VAC_CHILD"
                                        }
                                    ]
                                },
                                {
                                    "name": "malesChildren",
                                    "match": {
                                        "field": "resourceTag",
                                        "equalsFrom": "clientReferenceId"
                                    },
                                    "entity": "UserActionModel",
                                    "filters": [
                                        {
                                            "field": "additionalFields.fields.formType",
                                            "equals": "GROUP_VAC_CHILD"
                                        },
                                        {
                                            "field": "additionalFields.fields.childSex",
                                            "equals": "MALE"
                                        }
                                    ]
                                },
                                {
                                    "name": "femaleChildren",
                                    "match": {
                                        "field": "resourceTag",
                                        "equalsFrom": "clientReferenceId"
                                    },
                                    "entity": "UserActionModel",
                                    "filters": [
                                        {
                                            "field": "additionalFields.fields.formType",
                                            "equals": "GROUP_VAC_CHILD"
                                        },
                                        {
                                            "field": "additionalFields.fields.childSex",
                                            "equals": "FEMALE"
                                        }
                                    ]
                                },
                                {
                                    "name": "referrals",
                                    "match": {
                                        "field": "resourceTag",
                                        "equalsFrom": "clientReferenceId"
                                    },
                                    "entity": "UserActionModel",
                                    "filters": [
                                        {
                                            "field": "additionalFields.fields.formType",
                                            "equals": "GROUP_VAC_REFERRAL"
                                        }
                                    ]
                                }
                            ],
                            "rootEntity": "UserActionModel",
                            "wrapperName": "ClfSessionsListWrapper",
                            "searchConfig": {
                                "select": [
                                    "userAction"
                                ],
                                "orderBy": {
                                    "field": "clientCreatedTime",
                                    "order": "DESC"
                                },
                                "primary": "userAction"
                            }
