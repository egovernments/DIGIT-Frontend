                {
                  "actionType": "NAVIGATION",
                  "properties": {
                    "data": [
                      {
                        "key": "HouseholdClientReferenceId",
                        "value": "{{navigation.HouseholdClientReferenceId}}"
                      },
                      {
                        "key": "UNIQUE_BENEFICIARY_ID",
                        "value": "{{latestBeneficiaryId}}"
                      }
                    ],
                    "name": "ADD_MEMBER",
                    "type": "FORM"
                  }
