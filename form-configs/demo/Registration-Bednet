                  "value":
                      "{{contextData.0.individuals.IndividualModel.mobileNumber}}",
                  "keyName": "MOBILE_NUMBER",
                  "modules": [
                    {
                      "REGISTRATION": {
                        "enabledPages": ["beneficiaryDetails"]
                      }
                    }
                  ],
                  "fieldKey": "mobileNumber",
                  "jsonPath":
                      "{{contextData.0.individuals.IndividualModel.mobileNumber}}",
